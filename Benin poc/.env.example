# Public HTTPS base URL of this deployment, no trailing slash.
# The wallet POSTs its response to <BASE_URL>/oid4vp/response, so it must be
# reachable from the phone (ngrok, Render, Railway, ...).
BASE_URL=http://localhost:3000
PORT=3000

# OpenID4VP client_id shown to the wallet. Per-RP overrides are optional.
CLIENT_ID=benin-eservices-rp.poc
# BEDC_CLIENT_ID=
# FDA_CLIENT_ID=
# Only for pre-1.0 wallets that need it, e.g. redirect_uri (then set
# CLIENT_ID=<BASE_URL>/oid4vp/response)
# CLIENT_ID_SCHEME=

# pex  = presentation_definition (OpenID4VP drafts 18-23)
# dcql = dcql_query (OpenID4VP 1.0)
QUERY_LANGUAGE=pex

# value     = full request in the QR code (dense QR)
# reference = short QR with request_uri (unsigned request object)
REQUEST_MODE=value

# Deep-link scheme opened by "Open wallet on this device"
WALLET_SCHEME=openid4vp://

# Verification policy (PoC defaults: verify and display, don't hard-fail)
REQUIRE_TRUSTED_ISSUER=false
REQUIRE_HOLDER_BINDING=false
# Folder with trusted issuer / IACA PEM certificates
# TRUST_DIR=./trust
# SD-JWT issuers whose keys may be fetched from <iss>/.well-known/jwt-vc-issuer
# TRUSTED_ISSUERS=https://issuer.benin.example/anip

# Accepted vct values for the Birth Certificate SD-JWT (comma-separated)
BIRTH_CERT_VCTS=https://credentials.benin.example/birth_certificate,eu.europa.ec.eudi.birth_certificate.1

# Adds the "Demo: simulate wallet" button (simulated ANIP issuer). Disable
# when testing with a real wallet only.
DEMO_MODE=true

# Cookie signing secret (random per start if unset)
# SESSION_SECRET=
