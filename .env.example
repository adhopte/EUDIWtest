# Public base URL of THIS deployment, no trailing slash.
# Locally with ngrok: whatever ngrok prints, e.g. https://abcd1234.ngrok-free.app
# On Render: https://<your-service-name>.onrender.com
BASE_URL=http://localhost:3000

# client_id_scheme used is redirect_uri, so client_id is derived
# automatically from BASE_URL + /api/response — no separate CLIENT_ID
# variable needed.

# Display name for the demo billing-company front-end.
BILLER_NAME=Konsa Énergie & Télécom

# Credential type identifiers the verifier asks for. Defaults match the
# EUDI ARF reference PID. If testing against a Benin-specific wallet /
# SIGMA Issuer build that uses different identifiers, override these.
PID_SDJWT_VCT=urn:eudi:pid:1
PID_MDOC_DOCTYPE=eu.europa.ec.eudi.pid.1

PORT=3000
