# Public base URL of THIS deployment, no trailing slash.
# Locally with ngrok: whatever ngrok prints, e.g. https://abcd1234.ngrok-free.app
# On Render: https://<your-service-name>.onrender.com
BASE_URL=http://localhost:3000

# client_id the wallet will see in the authorization request.
# For a real ARF-conformant wallet this normally needs to be a
# resolvable identifier (e.g. did:web or x509_san_dns client_id scheme).
# For a dummy/PoC verifier, redirect_uri scheme is fine.
CLIENT_ID=dummy-rp.benin-poc

PORT=3000
