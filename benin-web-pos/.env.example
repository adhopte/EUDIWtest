PORT=3000

# Trusted issuer certificates (PEM). Put the ANIP IACA here in production.
# TRUST_DIR=./trust

# Simulated ANIP issuer + wallet ("Demo without a phone") and the
# "Trust this issuer (demo)" button. Never enable in production.
DEMO_MODE=true

# Simulated payment gateway
DEMO_PIN=1234
PIN_ATTEMPTS=3

# Default BLE write size (bytes, prefix included; 20–512). 20 works with every phone.
# BLE_CHUNK_SIZE=20
