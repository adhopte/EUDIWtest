# Public HTTPS URL of this deployment, no trailing slash. On Render it is read
# from RENDER_EXTERNAL_URL automatically; set it only for a custom domain.
# BASE_URL=https://anip-web-pos.onrender.com
PORT=3000

# OpenID4VP request profile. Defaults = what the SIGMA wallet accepts without a
# verifier certificate: request by value, DCQL, client_id redirect_uri:<response_uri>,
# encrypted response.
# REQUEST_MODE=value            # or reference (short QR; needs a wallet that accepts unsigned request objects)
# CLIENT_ID=redirect_uri:<BASE_URL>/oid4vp/response
# RESPONSE_MODE=direct_post.jwt # or direct_post
# DCQL_CLAIM_SETS=true          # false = every attribute mandatory, QR version 27 instead of 29
# WALLET_SCHEME=openid4vp://

# Trusted issuer certificates (PEM). Put the ANIP IACA here in production.
# TRUST_DIR=./trust

# Simulated ANIP issuer + wallet and the "Trust this issuer (demo)" button.
DEMO_MODE=true

# Simulated payment gateway
DEMO_PIN=1234
PIN_ATTEMPTS=3
